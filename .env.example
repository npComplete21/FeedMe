DATABASE_URL=postgresql+psycopg://feedme:feedme@localhost:5432/feedme
TEST_DATABASE_URL=postgresql+psycopg://feedme:feedme@localhost:5432/feedme_test

ANTHROPIC_API_KEY=
# Optional: override the model used for recipe parsing (default: claude-opus-4-8)
# RECIPE_PARSER_MODEL=claude-haiku-4-5

# Signs/verifies login tokens (see ADR-0015). Rotating this invalidates every
# outstanding login for everyone - the "log everyone out" break-glass option.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# How long a login stays valid before re-authentication is required.
JWT_EXPIRATION_DAYS=14

# Required to register a new account - hand this out to the people you want
# to have access, not published anywhere public.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
FEEDME_REGISTRATION_CODE=
